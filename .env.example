# Copia este archivo como .env.local y pega tus llaves de Wompi SANDBOX
# (Dashboard de Wompi → Desarrolladores / Mi cuenta → "Secretos para integración técnica").
# ⚠️ Nunca subas .env.local a git ni le pongas el prefijo VITE_ (eso las expondría al navegador).

WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx

# URL pública de la tienda (Wompi redirige aquí tras pagar)
APP_URL=http://localhost:5173
